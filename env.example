# Vercel 배포용 환경 변수 예시
# 실제 배포 시 Vercel 대시보드에서 설정하세요

# 개발 환경
NODE_ENV=production

# 애플리케이션 설정
NEXT_PUBLIC_APP_NAME=Beeve Web
NEXT_PUBLIC_APP_VERSION=1.0.0

# API 설정 (필요시)
# NEXT_PUBLIC_API_URL=https://api.example.com
# API_SECRET_KEY=your-secret-key

# 분석 도구 (필요시)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=XXXXXXX

# 카카오 로그인 설정
NEXT_PUBLIC_KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

# 구글 로그인 설정
NEXT_PUBLIC_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# 기타 서비스 (필요시)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
